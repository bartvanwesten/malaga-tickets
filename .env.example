# Copy to .env for local runs. In GitHub Actions these are repository secrets.
# Who gets the alerts (comma-separated), and who gets the weekly status / failure mails.
MAIL_TO=
STATUS_TO=
# Gmail with an app password (https://myaccount.google.com/apppasswords) can mail anyone.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Without SMTP, Resend's test sender is used; it only delivers to the Resend account's own address (STATUS_TO).
RESEND_API_KEY=
